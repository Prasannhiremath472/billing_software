# Base URL of the REST API. Leave unset in development (Vite proxies /api to the backend).
# In production set the full URL, e.g. https://api.yourdomain.com/api/v1
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Dev only: where the Vite proxy forwards /api (default http://localhost:4000)
# VITE_DEV_API_TARGET=http://localhost:4000
